# Copia este archivo como ".env" y ajusta los valores a tu MySQL local.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roles_app

# Cambia este texto por uno largo y secreto (firma los tokens de sesión).
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_unico
JWT_EXPIRES_IN=8h
